#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYTHONDONTWRITEBYTECODE = 1

PKGROOT      := debian/melband-roformer
VENV         := $(PKGROOT)/usr/lib/melband-roformer/venv
VENV_STAGE   := $(CURDIR)/.venv-build
TORCH_INDEX  := https://download.pytorch.org/whl/cu130
PYPI_INDEX   := https://pypi.org/simple

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	rm -rf $(VENV_STAGE)
	python3 -m venv --copies --system-site-packages $(VENV_STAGE)
	$(VENV_STAGE)/bin/python3 -m pip install --upgrade pip wheel
	$(VENV_STAGE)/bin/python3 -m pip install \
		--index-url $(TORCH_INDEX) \
		--extra-index-url $(PYPI_INDEX) \
		-r app/requirements.txt
	$(VENV_STAGE)/bin/python3 -m pip install --no-deps ./app

override_dh_auto_test:
	$(VENV_STAGE)/bin/python3 -m pytest $(CURDIR)/tests -v \
		-k "not RUN_MODEL and not RUN_GPU" || \
		(echo "Build-time tests failed -- see README.debian.md; this does " \
		      "not by itself prove GPU/model behaviour, only CPU-only " \
		      "import/CLI/argument-parsing correctness." >&2; exit 1)

override_dh_auto_install:
	install -d $(dir $(VENV))
	mv $(VENV_STAGE) $(VENV)
	grep -rIl -- "$(VENV_STAGE)" $(VENV)/bin | while read -r f; do \
		sed -i "s|$(VENV_STAGE)|/usr/lib/melband-roformer/venv|g" "$$f"; \
	done
	head -n1 $(VENV)/bin/pip | grep -q "^#!/usr/lib/melband-roformer/venv/bin/python3" \
		|| (echo "ERROR: venv shebang rewrite failed." >&2; exit 1)

	install -d $(PKGROOT)/usr/bin
	install -m 0755 debian/melband-roformer.launcher $(PKGROOT)/usr/bin/melband-roformer
	install -m 0755 debian/melband-roformer-gui.launcher $(PKGROOT)/usr/bin/melband-roformer-gui
	install -m 0755 debian/mseparate.launcher $(PKGROOT)/usr/bin/mseparate

	install -d $(PKGROOT)/usr/share/applications
	install -m 0644 data/melband-roformer.desktop $(PKGROOT)/usr/share/applications/
	install -d $(PKGROOT)/usr/share/icons/hicolor/scalable/apps
	install -m 0644 data/melband-roformer.svg $(PKGROOT)/usr/share/icons/hicolor/scalable/apps/

	install -d $(PKGROOT)/usr/share/doc/melband-roformer
	install -m 0644 README.md README.debian.md $(PKGROOT)/usr/share/doc/melband-roformer/

	install -d $(PKGROOT)/usr/share/man/man1
	install -m 0644 man/melband-roformer.1 $(PKGROOT)/usr/share/man/man1/
	gzip -9nf $(PKGROOT)/usr/share/man/man1/melband-roformer.1
	install -m 0644 man/mseparate.1 $(PKGROOT)/usr/share/man/man1/
	gzip -9nf $(PKGROOT)/usr/share/man/man1/mseparate.1

override_dh_shlibdeps:
	dh_shlibdeps --exclude=usr/lib/melband-roformer/venv

override_dh_dwz:
	dh_dwz --exclude=usr/lib/melband-roformer/venv

override_dh_strip:
	dh_strip --exclude=usr/lib/melband-roformer/venv

override_dh_compress:
	dh_compress --exclude=usr/lib/melband-roformer/venv
