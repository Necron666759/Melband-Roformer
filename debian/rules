#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYTHONDONTWRITEBYTECODE = 1

PKGROOT      := debian/melband-roformer
VENV         := $(PKGROOT)/usr/lib/melband-roformer/venv
# Built outside debian/<package> on purpose: dh_prep (which runs between
# dh_auto_test and dh_auto_install in the standard dh binary sequence) wipes
# debian/<package> clean. Building straight into $(VENV) meant dh_prep threw
# away the whole venv right after the tests had validated it, so the shipped
# .deb silently ended up with no venv at all. Building into a staging dir
# outside debian/<package>, then moving it into place from
# override_dh_auto_install (i.e. after dh_prep has already run), fixes that.
VENV_STAGE   := $(CURDIR)/.venv-build
# Keep in sync with app/requirements.txt (same channel/pins) and with
# TORCH_CUDA_CHANNEL / MIN_DRIVER_VERSION in
# app/melband_roformer_wrapper/gpuinfo.py, which is the single place the
# runtime --info/--self-test driver-floor check reads from.
TORCH_INDEX  := https://download.pytorch.org/whl/cu126
PYPI_INDEX   := https://pypi.org/simple

# No top-level setup.py/Makefile to auto-detect: everything happens in the
# overrides below.
%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	# --system-site-packages: see README.debian.md ("why --system-site-packages")
	# -- lets the optional GUI see the system's python3-gi if installed,
	# without letting system numpy/etc shadow our pinned versions (venv
	# site-packages always takes priority for same-named packages).
	rm -rf $(VENV_STAGE)
	python3 -m venv --copies --system-site-packages $(VENV_STAGE)
	$(VENV_STAGE)/bin/python3 -m pip install --upgrade pip wheel
	$(VENV_STAGE)/bin/python3 -m pip install \
		--index-url $(TORCH_INDEX) \
		--extra-index-url $(PYPI_INDEX) \
		-r app/requirements.txt
	$(VENV_STAGE)/bin/python3 -m pip install --no-deps ./app

override_dh_auto_test:
	# Only the always-run tier (no model download, no GPU needed) -- see
	# tests/test_cli.py docstring. This runs against the *build-time* venv,
	# which is bit-for-bit what ships (see override_dh_auto_install: it is
	# moved, not rebuilt, into $(VENV) after this).
	$(VENV_STAGE)/bin/python3 -m pytest $(CURDIR)/tests -v \
		-k "not RUN_MODEL and not RUN_GPU" || \
		(echo "Build-time tests failed -- see README.debian.md; this does " \
		      "not by itself prove GPU/model behaviour, only CPU-only " \
		      "import/CLI/argument-parsing correctness." >&2; exit 1)

override_dh_auto_install:
	# Move (not copy: avoids doubling disk usage / build time) the
	# already-tested venv into its final on-disk location, now that
	# dh_prep has already run and won't delete it out from under us.
	install -d $(dir $(VENV))
	mv $(VENV_STAGE) $(VENV)
	# pip wrote shebangs pointing at $(VENV_STAGE)/bin/python3 (the venv's
	# location at build time). Rewrite them to the real final path the
	# venv will live at once dpkg unpacks this package -- see
	# README.debian.md ("its shebangs are rewritten to the final
	# /usr/lib/melband-roformer/venv path before packaging").
	grep -rIl -- "$(VENV_STAGE)" $(VENV)/bin | while read -r f; do \
		sed -i "s|$(VENV_STAGE)|/usr/lib/melband-roformer/venv|g" "$$f"; \
	done
	# Sanity check the rewrite actually took, rather than assuming it:
	head -n1 $(VENV)/bin/pip | grep -q "^#!/usr/lib/melband-roformer/venv/bin/python3" \
		|| (echo "ERROR: venv shebangs do not point at the final on-disk path (/usr/lib/melband-roformer/venv) -- refusing to ship this build." >&2; exit 1)

	install -d $(PKGROOT)/usr/bin
	install -m 0755 debian/melband-roformer.launcher $(PKGROOT)/usr/bin/melband-roformer
	install -m 0755 debian/melband-roformer-gui.launcher $(PKGROOT)/usr/bin/melband-roformer-gui

	install -d $(PKGROOT)/usr/share/applications
	install -m 0644 data/melband-roformer.desktop $(PKGROOT)/usr/share/applications/

	install -d $(PKGROOT)/usr/share/icons/hicolor/scalable/apps
	install -m 0644 data/melband-roformer.svg $(PKGROOT)/usr/share/icons/hicolor/scalable/apps/

	install -d $(PKGROOT)/usr/share/doc/melband-roformer
	install -m 0644 README.md README.debian.md $(PKGROOT)/usr/share/doc/melband-roformer/

	install -d $(PKGROOT)/usr/share/man/man1
	install -m 0644 man/melband-roformer.1 $(PKGROOT)/usr/share/man/man1/
	gzip -9nf $(PKGROOT)/usr/share/man/man1/melband-roformer.1

override_dh_shlibdeps:
	# The venv contains vendored .so files (torch's bundled cuBLAS/cuDNN/
	# NCCL, numpy/scipy's compiled extensions) that are not tracked by
	# dpkg and are not meant to be resolved against Debian's shared
	# library database -- they ship their own runtime. Excluding them is
	# correct here, not a shortcut: their real runtime dependency (the
	# NVIDIA driver's userspace libs, for the CUDA .so files) is
	# explicitly NOT a dpkg Depends per this task's own requirement (the
	# driver is user-installed, outside apt's purview for this package).
	dh_shlibdeps --exclude=usr/lib/melband-roformer/venv

override_dh_dwz:
	# Same reasoning as override_dh_strip/override_dh_compress below: these
	# are prebuilt vendored binaries (not built by us), and dwz chokes on
	# at least one of them (triton's libtriton.so) anyway. Debug-info
	# extraction of third-party vendored .so files we didn't build and
	# can't usefully symbolicate is out of scope here.
	dh_dwz --exclude=usr/lib/melband-roformer/venv

override_dh_strip:
	# Do not strip vendored binaries we did not build (risk of breaking
	# prebuilt CUDA extension .so files for no real size benefit -- they
	# ship already-stripped release builds upstream).
	dh_strip --exclude=usr/lib/melband-roformer/venv

override_dh_compress:
	# Don't let dh_compress touch anything under the venv (e.g. it must
	# never gzip a .so or a .py bytecode cache path).
	dh_compress --exclude=usr/lib/melband-roformer/venv
