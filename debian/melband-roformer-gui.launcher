#!/bin/sh
# Thin dispatcher for the optional GTK4 GUI. Requires python3-gi and
# gir1.2-gtk-4.0 (Recommends, not Depends -- CLI works without them).
set -e
if ! /usr/lib/melband-roformer/venv/bin/python3 -c 'import gi' 2>/dev/null; then
    echo "melband-roformer-gui: PyGObject (python3-gi) not found." >&2
    echo "Install it with: sudo apt install python3-gi gir1.2-gtk-4.0" >&2
    exit 1
fi
exec /usr/lib/melband-roformer/venv/bin/python3 -m melband_roformer_wrapper.gui "$@"
